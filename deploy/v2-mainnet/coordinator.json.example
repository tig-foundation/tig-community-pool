{
  "tig_api_url": "https://mainnet-api.tig.foundation",
  "pool_player_id": "REPLACE_POOL_WALLET",
  "public_origin": "https://REPLACE_POOL_API_HOSTNAME",
  "release_manifest_file": "/etc/innopool-v2-mainnet/release-manifest.json",
  "require_pilot_limits": false,
  "submissions_enabled": false,
  "new_work_enabled": false,
  "binary_hosts": [
    "mainnet-api.tig.foundation",
    "media.githubusercontent.com"
  ],
  "max_block_age": 120,
  "binary_reuse_seconds": 86400,
  "reference_max_age_seconds": 1800,
  "submission_timeout_seconds": 60,
  "precommit_interval_seconds": 6
}
